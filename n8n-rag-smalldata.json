    {
      "parameters": {
        "jsCode": "// Get raw output from AI Agent\nconst rawOutput = $input.item.json.output || \"\";\n\n// Clean or convert Markdown format to HTML for neatness\nlet formattedBody = rawOutput\n  // Convert ### headings to bold with spacing\n  .replace(/###\\s*(.*?)(?=\\n|$)/g, '<br><br><b>$1</b><br>')\n  // Convert **bold** markdown to HTML <b> tags\n  .replace(/\\*\\*(.*?)\\*\\*/g, '<b>$1</b>')\n  // Convert bullet points or list markers\n  .replace(/\\*\\s/g, '<br>• ')\n  // Clean up Markdown table symbols if present\n  .replace(/\\|/g, ' &nbsp; ')\n  // Replace line breaks (\\n) with HTML line break tags (<br>)\n  .replace(/\\n/g, '<br>');\n\n// Combine with question format and footer\nconst finalBody = `\n  <p><b>질문:</b> 스몰데이터에 대해 설명해줘</p>\n  <p><b>답변:</b><br>${formattedBody}</p>\n  <hr>\n  <p><small>본 메일은 '미래AI기술.pdf' 문서 기반 RAG 워크플로우(n8n)에서 자동 발송되었습니다.</small></p>\n`;\n\nreturn [{ json: { body: finalBody } }];"
      },
